{
  // Cloudflare Workers Builds: set Build command to python3 tools/build_cloudflare.py.
  // The current source is stored in lossless parts; dist/index.html is generated at build time.
  // IMPORTANT: If the linked Cloudflare Worker is not called "self",
  // change "name" to EXACTLY match the existing Worker to avoid deploying a new Worker.
  "name": "self",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
